{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": false,
    "incremental": false,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": "lib/types"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
