{
  "name": "dsh-sandbox-escalation-fix",
  "version": "0.1.2-alpha2",
  "description": "Session-aware sandbox escalation compatibility plugin for DeepSeek Harness",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "sandbox",
    "plugin"
  ],
  "homepage": "https://github.com/JUSTMONIKA2022/dsh-sandbox-escalation-fix#readme",
  "bugs": {
    "url": "https://github.com/JUSTMONIKA2022/dsh-sandbox-escalation-fix/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUSTMONIKA2022/dsh-sandbox-escalation-fix.git"
  },
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./wrapper-protocol": {
      "types": "./lib/wrapper-protocol.d.mts",
      "default": "./lib/wrapper-protocol.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "deploy-web-profile.ps1",
    "README.md",
    "README.zh.md",
    "Tutorials that even Peppa Pig can understand",
    "???????????.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/tsdown/dist/run.mjs",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
