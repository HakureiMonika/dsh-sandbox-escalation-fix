    "@deepseek-ai/dsh-sandbox": ">=0.1.0-rc.5 <0.1.0-rc.9 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0-rc.5 <0.1.0-rc.9 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-scope": ">=0.1.0-rc.5 <0.1.0-rc.9 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <0.1.0-rc.9 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.1.0-rc.9 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5 <0.1.0-rc.9 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-alpha.1 || 0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1"
